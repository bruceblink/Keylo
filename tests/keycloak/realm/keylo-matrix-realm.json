{
  "realm": "keylo-matrix",
  "enabled": true,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "keylo-upstream-matrix",
      "name": "Keylo upstream OIDC matrix",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_MATRIX_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KEYLO_MATRIX_REDIRECT_URI}"],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "matrix userinfo-only username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "matrix_username",
            "claim.name": "matrix_userinfo_marker",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "matrix-user",
      "enabled": true,
      "email": "matrix-user@example.test",
      "emailVerified": true,
      "attributes": {
        "matrix_username": ["matrix-userinfo"]
      },
      "firstName": "Matrix",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_MATRIX_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
